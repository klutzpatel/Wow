<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Special Gift</title>
    <style>
        body {
            margin: 0;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 50%, #fecfef 100%);
            font-family: Arial, sans-serif;
            overflow: hidden;
        }
        .gift-container {
            perspective: 1000px;
            perspective-origin: center center;
            cursor: pointer;
        }
        .gift-box {
            width: 220px;
            height: 220px;
            position: relative;
            transform-style: preserve-3d;
            transition: transform 0.8s;
        }
        .gift-box.opened {
            transform: rotateY(180deg);
        }
        .gift-face {
            position: absolute;
            width: 200px;
            height: 200px;
            left: 10px;
            top: 10px;
            background: #d32f2f;
            border: 8px solid #8b4513;
            box-sizing: border-box;
        }
        .front { transform: translateZ(100px); }
        .back { 
            transform: rotateY(180deg) translateZ(100px); 
            background: linear-gradient(135deg, #4a90e2, #357abd);
        }
        .left { transform: rotateY(-90deg) translateZ(100px); }
        .right { transform: rotateY(90deg) translateZ(100px); }
        .top {
            background: linear-gradient(45deg, #ffd700, #ffed4e);
            border-color: #ff6f00;
            transform: rotateX(90deg) translateZ(100px);
        }
        .bottom {
            background: #8b4513;
            transform: rotateX(-90deg) translateZ(100px);
        }
        .ribbon {
            position: absolute;
            top: -10px;
            left: -10px;
            right: -10px;
            height: 20px;
            background: linear-gradient(90deg, #ff4081, #e91e63, #ff4081);
            border-radius: 10px;
            z-index: 100;
        }
        .ribbon::after {
            content: '';
            position: absolute;
            top: -10px;
            right: -10px;
            width: 20px;
            height: 20px;
            background: #ffd700;
            border-radius: 50%;
            transform: rotate(45deg);
            box-shadow: 0 2px 5px rgba(0,0,0,0.3);
        }
        .photo-reveal {
            position: absolute;
            width: 200px;
            height: 200px;
            left: 10px;
            top: 10px;
            transform: rotateY(180deg) translateZ(100.1px);
            backface-visibility: hidden;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            box-sizing: border-box;
        }
        .photo-reveal img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .message {
            margin-top: 30px;
            text-align: center;
            font-size: 20px;
            color: #333;
            font-weight: bold;
            text-shadow: 0 2px 4px rgba(255,255,255,0.8);
            transition: all 0.3s ease;
        }
        @media (max-width: 480px) {
            .gift-box {
                width: 170px;
                height: 170px;
            }
            .gift-face, .photo-reveal {
                width: 150px;
                height: 150px;
                left: 10px;
                top: 10px;
            }
            .ribbon {
                top: -8px;
                left: -8px;
                right: -8px;
                height: 16px;
            }
            .message {
                font-size: 18px;
                margin-top: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="gift-container" onclick="toggleGift()" ontouchstart="toggleGift()">
        <div class="gift-box" id="giftBox">
            <div class="gift-face front"></div>
            <div class="gift-face back"></div>
            <div class="gift-face left"></div>
            <div class="gift-face right"></div>
            <div class="gift-face top"></div>
            <div class="gift-face bottom"></div>
            <div class="ribbon"></div>
            <div class="photo-reveal">
                <img src="https://via.placeholder.com/400x400/4a90e2/ffffff?text=Have+a+Nice+Day" alt="Your Gift Photo">
            </div>
        </div>
        <div class="message" id="message">Tap/Click the gift to open it!</div>
    </div>

    <script>
        function toggleGift() {
            const box = document.getElementById('giftBox');
            const message = document.getElementById('message');
            
            box.classList.toggle('opened');
            
            if (box.classList.contains('opened')) {
                message.textContent = 'Surprise! 💝 Have a nice day!';
                message.style.color = '#4a90e2';
            } else {
                message.textContent = 'Tap/Click the gift to open it!';
                message.style.color = '#333';
            }
        }
    </script>
</body>
</html>
